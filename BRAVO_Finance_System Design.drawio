        <mxCell id="3" value="Workbook legend and usage" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="32" y="56" width="1436" height="32" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Download the Python generator and run it with Python 3. It writes native editable mxGraph XML. Open BRAVO_Finance_Drawio.drawio in diagrams.net (app.diagrams.net) or use File → Import From → Device." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#7F6000;fontColor=#333333;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="650" height="180" as="geometry" />
        </mxCell>
        <mxCell id="5" value="BPMN pages use editable process shapes and participant lanes. Review message-flow arrows and, if your submission requires strict BPMN 2.0 interchange, refine pools/events in the BPMN shape library. DFD processes/stores/entities use distinct shapes and labels." style="shape=note;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#17365D;fontColor=#333333;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="780" y="120" width="650" height="180" as="geometry" />
        </mxCell>
        <mxCell id="6" value="All diagrams inherit shared policies from the BRAVO Finance Module specification: oldest-due-first allocation, confirmed payments only, overpayment as student credit, two independent refund approvals, immutable posted finance records, balanced journals, scoped RBAC, and as-of clearance." style="shape=note;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#548235;fontColor=#333333;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="1370" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
